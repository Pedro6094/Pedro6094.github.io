
/* ========================================
   1. CONFIGURACIÓN GENERAL
======================================== */

:root {
    --background: #080d18;
    --surface: #111a2b;
    --surface-hover: #18243a;
    --primary: #38bdf8;
    --secondary: #818cf8;
    --text: #f1f5f9;
    --text-muted: #94a3b8;
    --border: #253249;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background-color: var(--background);
    color: var(--text);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.6;
}

a {
    color: inherit;
    text-decoration: none;
}

.container {
    width: 90%;
    max-width: 1150px;
    margin: auto;
}


/* ========================================
   2. NAVEGACIÓN
======================================== */

.header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 13, 24, 0.95);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
}

.navbar {
    min-height: 75px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.logo {
    font-size: 1.8rem;
    font-weight: bold;
}

.logo span {
    color: var(--primary);
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 28px;
}

.nav-links a {
    color: var(--text-muted);
    transition: color 0.3s;
}

.nav-links a:hover {
    color: var(--primary);
}


/* ========================================
   3. PRESENTACIÓN PRINCIPAL
======================================== */

.hero {
    min-height: 650px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 50px;
    padding-top: 70px;
    padding-bottom: 70px;
}

.greeting {
    color: var(--primary);
    font-weight: bold;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: clamp(2.3rem, 5vw, 4rem);
    line-height: 1.15;
    margin-bottom: 25px;
}

.hero h1 span {
    color: var(--primary);
}

.hero-description {
    color: var(--text-muted);
    font-size: 1.05rem;
    max-width: 550px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 30px;
}

.btn {
    padding: 12px 22px;
    border-radius: 7px;
    font-weight: bold;
    transition: 0.3s;
}

.primary {
    background: var(--primary);
    color: #08111f;
}

.primary:hover {
    background: #7dd3fc;
    transform: translateY(-3px);
}

.secondary {
    border: 1px solid var(--primary);
    color: var(--primary);
}

.secondary:hover {
    background: var(--surface);
}


/* ========================================
   4. TARJETA DE CÓDIGO
======================================== */

.code-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 25px;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.3);
    overflow-x: auto;
}

.code-card p {
    color: var(--primary);
    margin-bottom: 18px;
    font-weight: bold;
}

.code-card pre {
    color: #a5f3fc;
    font-size: 0.85rem;
    white-space: pre;
}


/* ========================================
   5. SECCIONES
======================================== */

.section {
    padding-top: 90px;
    padding-bottom: 90px;
}

.section h2 {
    font-size: 2rem;
    margin-bottom: 30px;
    position: relative;
}

.section h2::after {
    content: "";
    display: block;
    width: 55px;
    height: 3px;
    background: var(--primary);
    margin-top: 10px;
}

.section > p {
    color: var(--text-muted);
    max-width: 800px;
}

.section-description {
    margin-bottom: 30px;
}


/* ========================================
   6. HABILIDADES
======================================== */

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.skill-card {
    background: var(--surface);
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-5px);
    background: var(--surface-hover);
    border-color: var(--primary);
}

.skill-card h3 {
    color: var(--primary);
    margin-bottom: 10px;
}

.skill-card p {
    color: var(--text-muted);
}


/* ========================================
   7. PROYECTOS
======================================== */

.projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.project-card {
    background: var(--surface);
    padding: 25px;
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
}

.project-card h3 {
    color: var(--text);
    margin-bottom: 15px;
}

.project-card p {
    color: var(--text-muted);
    margin-bottom: 20px;
}

.project-card span {
    color: var(--primary);
    font-size: 0.85rem;
    font-weight: bold;
}


/* ========================================
   8. CONTACTO
======================================== */

.contact-links {
    margin-top: 25px;
    display: flex;
    gap: 15px;
}

.contact-links a {
    color: var(--primary);
    border: 1px solid var(--primary);
    padding: 10px 20px;
    border-radius: 7px;
    transition: 0.3s;
}

.contact-links a:hover {
    background: var(--primary);
    color: var(--background);
}


/* ========================================
   9. PIE DE PÁGINA
======================================== */

.footer {
    text-align: center;
    padding: 30px 15px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
}


/* ========================================
   10. DISEÑO RESPONSIVE
======================================== */

@media (max-width: 850px) {

    .hero {
        grid-template-columns: 1fr;
        min-height: auto;
    }

    .skills-grid,
    .projects-grid {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media (max-width: 600px) {

    .navbar {
        flex-direction: column;
        padding-top: 15px;
        padding-bottom: 15px;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        font-size: 0.85rem;
    }

    .hero h1 {
        font-size: 2.3rem;
    }

    .skills-grid,
    .projects-grid {
        grid-template-columns: 1fr;
    }

    .section {
        padding-top: 60px;
        padding-bottom: 60px;
    }

}
